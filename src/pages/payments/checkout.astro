---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div
    id="redirect-container"
    class="flex flex-col items-center justify-center min-h-screen mx-auto"
  >
    <p class="text-lg mb-4">Redirecting to payment gateway...</p>
    <div class="w-12 h-12 border-t-4 border-blue-500 rounded-full animate-spin"></div>
  </div>

  <!-- Status container to show success or error messages -->
  <div id="status-container" class="mt-6 text-center"></div>

  <script>
    // Snipcart sends the customer here with its public token in the query string. The token is
    // a credential for the payment session, so take it out of the address bar (and so out of
    // browser history) straight away, and never store it.
    const token = new URLSearchParams(window.location.search).get(
      "publicToken",
    );
    history.replaceState(null, "", window.location.pathname);

    function showError(message: string) {
      const statusContainer = document.getElementById("status-container");
      if (statusContainer) {
        const paragraph = document.createElement("p");
        paragraph.className = "text-lg text-red-500";
        paragraph.textContent = message;

        // The token is gone from the address bar, so the customer restarts from the shop
        const link = document.createElement("a");
        link.href = "/";
        link.className = "inline-block mt-4 text-blue-500 underline";
        link.textContent = "Return to the shop";
        statusContainer.replaceChildren(paragraph, link);
      }
    }

    async function processCheckout() {
      if (!token) {
        showError(
          "This payment link has already been used. Please start again from your cart.",
        );
        return;
      }

      try {
        const response = await fetch("/.netlify/functions/checkout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ publicToken: token }),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error ?? `Unknown error ${response.status}`);
        }
        if (!result.redirectUri) {
          throw new Error("No redirect URI found");
        }

        window.location.href = result.redirectUri;
      } catch (err) {
        showError(
          err instanceof Error
            ? `Unable to process payment. Error: ${err.message}`
            : "An unknown error occurred.",
        );
      }
    }

    processCheckout();
  </script>
</BaseLayout>
