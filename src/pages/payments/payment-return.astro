---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="flex flex-col items-center justify-center min-h-screen bg-gray-100">
    <div class="bg-white p-8 rounded-lg shadow-md max-w-md w-full">
      <h1 class="text-2xl font-bold mb-4 text-center text-gray-800">
        Payment Processing
      </h1>

      <div id="loading" class="text-center">
        <p class="mb-4 text-gray-600">
          Processing your payment, please wait...
        </p>
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto"></div>
      </div>

      <div id="result" class="hidden text-center">
        <div
          id="resultMessage"
          class="mb-4 text-lg flex flex-col items-center"
        ></div>
        <a
          href="/"
          class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors"
        >
          Return to Home
        </a>
      </div>
    </div>
  </div>

  <script>
    // How long to keep asking for the outcome once the customer is back from the bank
    const POLL_WINDOW_MS = 120_000;
    // BlinkPay adds a status parameter only when the outcome was not a success. The outcome
    // still comes from the server, but there is no point waiting two minutes for it.
    const UNSUCCESSFUL_POLL_WINDOW_MS = 10_000;
    const POLL_INTERVAL_MS = 1_000;

    type ReturnResult = {
      status?: "pending" | "paid" | "failed";
      returnUrl?: string;
      error?: string;
    };

    async function processPayment() {
      // BlinkPay returns the customer with the session ID we put on the redirect URI and its
      // own cid (the quick payment ID). Neither is a credential.
      const urlParams = new URLSearchParams(window.location.search);
      const session = urlParams.get("session");
      const cid = urlParams.get("cid");

      if (!session || !cid) {
        showResult("Missing required parameters. Please try again.");
        return;
      }

      const url = `/.netlify/functions/payment-return?session=${encodeURIComponent(session)}&cid=${encodeURIComponent(cid)}`;
      const returnedUnsuccessful = urlParams.has("status");
      const deadline =
        Date.now() +
        (returnedUnsuccessful ? UNSUCCESSFUL_POLL_WINDOW_MS : POLL_WINDOW_MS);
      let lastError = "";

      while (Date.now() < deadline) {
        try {
          const response = await fetch(url);
          const result: ReturnResult = await response.json().catch(() => ({}));

          if (response.ok && result.returnUrl) {
            // Snipcart shows the order confirmation, or the failure message, from here
            window.location.href = result.returnUrl;
            return;
          }
          if (response.status >= 400 && response.status < 500) {
            showResult(result.error ?? `Unknown error ${response.status}`);
            return;
          }
          lastError = result.error ?? "";
        } catch (error) {
          console.error("Error checking payment", error);
        }
        await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
      }

      showResult(
        lastError ||
          (returnedUnsuccessful
            ? "Your payment was not completed. Please return to the shop to try again."
            : "We haven't received confirmation of your payment yet. If you completed it at your bank, please contact us before trying again."),
      );
    }

    function showResult(message: string) {
      document.getElementById("loading")?.classList.add("hidden");
      document.getElementById("result")?.classList.remove("hidden");

      const resultMessageEl = document.getElementById("resultMessage");
      if (resultMessageEl) {
        const span = document.createElement("span");
        span.className = "text-red-500";
        span.textContent = message;
        resultMessageEl.replaceChildren(span);
      }
    }

    processPayment();
  </script>
</BaseLayout>
